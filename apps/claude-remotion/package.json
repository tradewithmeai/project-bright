{
  "name": "project-bright-studio",
  "version": "0.1.0-beta.1",
  "description": "Remotion compositions, skills and render scripts for Project Bright - a video studio driven from Claude Code. Videos are hand-authored per project; rendering is a local command.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tradewithmeai/project-bright.git",
    "directory": "apps/claude-remotion"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "type": "module",
  "private": true,
  "dependencies": {
    "@code-hike/lighter": "1.0.3",
    "@remotion/cli": "4.0.521",
    "@remotion/google-fonts": "4.0.521",
    "@remotion/layout-utils": "4.0.521",
    "@remotion/studio": "4.0.521",
    "codehike": "1.0.4",
    "polished": "4.3.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.521",
    "twoslash-cdn": "0.3.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.521",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "^9.39.4",
    "prettier": "3.8.1",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "hello": "node scripts/hello.mjs",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "tsc && eslint src",
    "check:assets": "node scripts/check-assets.mjs && node scripts/check-edition-assets.mjs",
    "check:grid": "node scripts/check-ai-top5-grid.mjs",
    "check:landing": "esbuild scripts/check-screen-landing.mjs --bundle --platform=node --format=cjs --loader:.tsx=tsx --jsx=automatic --outfile=node_modules/.cache/check-screen-landing.cjs && node node_modules/.cache/check-screen-landing.cjs",
    "check:compositions": "node scripts/check-compositions.mjs"
  }
}
