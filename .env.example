# Local studio environment — TEMPLATE (committed; safe, no real keys).
#
# Copy this to `.env` (gitignored) and fill in your keys, OR edit the `.env` that was
# created for you. The studio's CLI tools auto-load `.env` at the repo root:
#   - apps/claude-remotion/scripts/make-ai-top5.mjs   (writes script + TTS)  → OPENAI_API_KEY [+ ELEVENLABS_API_KEY]
#   - apps/claude-remotion/scripts/generate-vo.mjs     (TTS)                  → OPENAI_API_KEY / ELEVENLABS_API_KEY
#   - studio/tools/analyse_clip.py                (Gemini clip analysis) → GOOGLE_AI_KEY
#
# A key already exported in your shell ALWAYS wins over this file (the loader never overrides).
#
# ⚠️ This file is loaded by the studio tools REGARDLESS of your shell environment, so clearing a
# shell variable does NOT produce a keyless run. To test a keyless path, use a checkout with no
# .env at all. See also apps/claude-remotion/.env.example for the video app's own keys.

# ── Required for the daily AI Top 5 video ──
OPENAI_API_KEY=          # script writing (gpt-4o-mini) + default TTS (gpt-4o-mini-tts)
GOOGLE_AI_KEY=           # Gemini clip analysis (analyse_clip.py)

# ── Optional ──
ELEVENLABS_API_KEY=      # only if TTS_PROVIDER=elevenlabs (OpenAI is the default daily engine)

# ── Optional knobs (uncomment to override defaults) ──
# TTS_PROVIDER=openai            # openai | elevenlabs  (default: openai when OPENAI_API_KEY is set)
# OPENAI_TTS_VOICE=nova          # alloy | echo | fable | onyx | nova | shimmer | sage
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_STABILITY=0.4       # lower = more expressive/energetic
# PB_BUDGET_CREDITS=3000         # voiceover spend ceiling, reserved BEFORE each paid call
# PB_BUDGET_USD=                 # same, in dollars, for the OpenAI TTS path
